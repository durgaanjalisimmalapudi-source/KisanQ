[Unit]
Description=KisanQ Crop Doctor Edge Kiosk Service
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/KisanQ
ExecStart=/home/pi/KisanQ/.venv/bin/gunicorn app:app --bind 0.0.0.0:5001 --workers 1 --threads 4
Restart=always
RestartSec=5
Environment=PORT=5001
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
